{
  "name": "@webba_tech/capslane-mcp",
  "version": "0.1.5",
  "description": "MCP server for retrieving timestamped YouTube transcripts through Capslane.",
  "mcpName": "io.github.Webba-Creative-Technologies/capslane",
  "type": "module",
  "license": "MIT",
  "bin": {
    "capslane-mcp": "dist/stdio.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "server.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@webba_tech/capslane": "0.1.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "typescript": "5.9.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Webba-Creative-Technologies/capslane-mcp.git"
  },
  "author": "Webba Creative Technologies",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "youtube",
    "transcript",
    "captions",
    "chatgpt",
    "claude"
  ]
}
